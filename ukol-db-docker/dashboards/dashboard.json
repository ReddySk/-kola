{
    "id": null,
    "uid": "concrete-strength-analysis",
    "title": "Concrete Strength Analysis",
    "tags": ["concrete", "dataset2"],
    "timezone": "browser",
    "schemaVersion": 37,
    "version": 1,
    "refresh": "5s",
    "time": {
      "from": "now-7d",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Minimal/optimal composition of concrete mixture",
        "type": "table",
        "datasource": "MariaDB",
        "targets": [
          {
            "rawSql": "SELECT min(cement) AS cement, min(water) AS water, min(coarse_aggregate) AS coarse_aggregate, min(Superplasticizer) AS superplasticizer, strength FROM beton.concrete_data WHERE strength = (SELECT MAX(strength) FROM beton.concrete_data) GROUP BY strength;",
            "format": "table"
          }
        ],
        "gridPos": {
          "h": 4,
          "w": 24,
          "x": 0,
          "y": 2
        }
      },
      {
        "id": 2,
        "title": "Minimal Strength (MPa) by Age (days)",
        "type": "table",
        "datasource": "MariaDB",
        "targets": [
          {
            "rawSql": "SELECT age, min(strength) AS min_strength FROM concrete_data group by age ORDER BY age",
            "format": "table"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 8
        }
      },
      {
        "id": 3,
        "title": "Cement (kg in a m^3 mixture) vs Minimal Strength (MPa)",
        "type": "table",
        "datasource": "MariaDB",
        "targets": [
          {
            "rawSql": "SELECT cement, min(strength) AS min_strength FROM concrete_data GROUP BY cement ORDER BY cement",
            "format": "table"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        }
      },
      {
        "id": 4,
        "title": "Water Content (kg in a m^3 mixture) vs Minimal Strength (MPa)",
        "type": "table",
        "datasource": "MariaDB",
        "targets": [
          {
            "rawSql": "SELECT water, min(strength) AS min_strength FROM concrete_data GROUP BY water  ORDER BY water",
            "format": "table"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 16
        }
      },
      {
        "id": 5,
        "title": "Average Strength by Age",
        "type": "table",
        "datasource": "MariaDB",
        "targets": [
          {
            "rawSql": "SELECT age, AVG(strength) AS avg_strength FROM concrete_data GROUP BY age ORDER BY age",
            "format": "table"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 16
        }
      },
      {
        "id": 6,
        "title": "Dataset Summary",
        "type": "table",
        "datasource": "MariaDB",
        "targets": [
          {
            "rawSql": "SELECT * FROM concrete_summary",
            "format": "table"
          }
        ],
        "gridPos": {
          "h": 4,
          "w": 24,
          "x": 0,
          "y": 0
        }
      }
